{
  "name": "equilibrium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && prisma db push --skip-generate && next dev",
    "build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "demo:verify": "tsx scripts/verify-demo.ts",
    "ml:train": "tsx scripts/train-model.ts",
    "razorpay:check": "tsx scripts/razorpay-check.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "5.17.0",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.408.0",
    "next": "^16.3.3",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.50.1",
    "recharts": "^2.12.8",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.7.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "^1.41.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^15.0.6",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^1.2.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^23.0.1",
    "playwright": "^1.41.2",
    "prisma": "5.17.0",
    "tsx": "^4.7.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^1.2.0"
