generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Authentication and authorization
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            TenantUser[]
  suppliers        Supplier[]
  payments         PaymentIntent[]
  disputes         DisputeCase[]
  auditEvents      AuditEvent[]
  opportunities    LiquidityOpportunity[]
  invoices         Invoice[]
  controllerTraces ControllerTrace[]

  @@index([isActive])
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // VIEWER, OPERATOR, APPROVER, ADMIN (per-tenant)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model User {
  id        String   @id
  email     String   @unique
  name      String
  apiKey    String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants TenantUser[]

  @@index([email])
  @@index([isActive])
}

model Supplier {
  id                    String                 @id
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  email                 String
  riskTier              String
  createdAt             DateTime               @default(now())
  liquidityObservations LiquidityObservation[]
  opportunities         LiquidityOpportunity[]
  payments              PaymentIntent[]
  auditEvents           AuditEvent[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([riskTier])
}

model LiquidityObservation {
  id                    String   @id
  supplierId            String
  supplier              Supplier @relation(fields: [supplierId], references: [id])
  observedAt            DateTime
  availableBalancePaise Int
  inflowPaise           Int
  outflowPaise          Int
  daysRunway            Float
  paymentRegularity     Float
  volatility            Float
  source                String // DEMO_SYNTHETIC or AA_SANDBOX

  @@index([supplierId, observedAt])
}

model LiquidityOpportunity {
  id                      String   @id
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId              String
  supplier                Supplier @relation(fields: [supplierId], references: [id])
  predictionProbability   Float
  modelVersion            String
  featureSnapshotJson     String
  policyVersion           String
  expectedBenefitPaise    Int
  opportunityCostPaise    Int
  riskCostPaise           Int
  expectedValuePaise      Int
  recommendedDiscountBps  Int
  maxAllowedDiscountPaise Int
  status                  String // RECOMMENDED, APPROVED, REJECTED, EXECUTED, EXPIRED
  decisionReason          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([supplierId])
}

model PaymentIntent {
  id                     String    @id
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  internalReference      String    @unique
  provider               String    @default("RAZORPAY")
  providerPaymentId      String?   @unique
  providerOrderId        String?
  operationType          String // DISCOUNT_PAYOUT, ESCROW_HOLD, ESCROW_RELEASE, REFUND
  amountPaise            Int
  currency               String    @default("INR")
  status                 String // INTENT_CREATED, SUBMITTED, ACKNOWLEDGED, UNKNOWN, CONFIRMED, FAILED, REVERSED, MANUAL_REVIEW
  requestFingerprint     String
  providerIdempotencyKey String    @unique
  correlationId          String
  failureMode            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  confirmedAt            DateTime?

  // Maker-checker. Payments above the dual-approval threshold sit in
  // PENDING_APPROVAL until a second, different operator approves them.
  makerId                String?
  checkerId              String?
  approvalThresholdPaise Int?
  approvedAt             DateTime?

  supplierId          String
  supplier            Supplier             @relation(fields: [supplierId], references: [id])
  ledgerTransactions  LedgerTransaction[]
  outboxEvents        OutboxEvent[]
  eventRecords        EventRecord[]
  reconciliationCases ReconciliationCase[]

  @@index([tenantId])
  @@index([status])
  @@index([supplierId])
  @@index([correlationId])
  @@index([status, createdAt])
}

model LedgerTransaction {
  id              String         @id
  referenceType   String
  referenceId     String
  currency        String
  description     String
  createdAt       DateTime       @default(now())
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])
  entries         LedgerEntry[]

  @@index([referenceType, referenceId])
}

model LedgerEntry {
  id            String            @id
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountCode   String
  debitPaise    Int
  creditPaise   Int
  createdAt     DateTime          @default(now())

  @@index([transactionId])
}

model OutboxEvent {
  id              String         @id
  eventType       String
  aggregateType   String
  aggregateId     String
  payloadJson     String
  status          String         @default("PENDING") // PENDING, PUBLISHED, FAILED
  attemptCount    Int            @default(0)
  availableAt     DateTime       @default(now())
  lastError       String?
  correlationId   String
  createdAt       DateTime       @default(now())
  publishedAt     DateTime?
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  @@index([status, availableAt])
}

model EventRecord {
  id              String         @id
  eventType       String
  aggregateType   String
  aggregateId     String
  sequenceNumber  Int
  schemaVersion   String
  payloadJson     String
  source          String
  idempotencyKey  String         @unique
  correlationId   String
  createdAt       DateTime       @default(now())
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  @@index([aggregateType, aggregateId, sequenceNumber])
}

model AuditEvent {
  id            String    @id
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType     String
  actorType     String // SYSTEM, OPERATOR, PROVIDER, MODEL
  actorId       String
  aggregateType String
  aggregateId   String
  payloadJson   String
  modelVersion  String?
  policyVersion String?
  correlationId String
  createdAt     DateTime  @default(now())
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  // Tamper-evidence. Each entry hashes its own content together with the
  // previous entry's hash, so altering any historical row breaks every hash
  // after it. sequence is global and gap-free.
  sequence     Int    @unique
  previousHash String
  entryHash    String @unique

  @@index([tenantId])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
  @@index([sequence])
}

model DisputeCase {
  id                String             @id
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerDisputeId String
  paymentIntentId   String?
  reasonCode        String
  amountPaise       Int
  status            String // OPEN, DRAFT_READY, NEEDS_REVIEW, SUBMITTED, CLOSED
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  evidenceDocuments EvidenceDocument[]
  evidenceClaims    EvidenceClaim[]
  disputeDrafts     DisputeDraft[]

  @@index([tenantId])
  @@index([status])
}

model EvidenceDocument {
  id             String          @id
  disputeCaseId  String
  disputeCase    DisputeCase     @relation(fields: [disputeCaseId], references: [id])
  documentType   String
  title          String
  content        String
  trustedSource  Boolean
  createdAt      DateTime        @default(now())
  evidenceClaims EvidenceClaim[]
}

model EvidenceClaim {
  id               String           @id
  disputeCaseId    String
  disputeCase      DisputeCase      @relation(fields: [disputeCaseId], references: [id])
  claimText        String
  normalizedField  String
  normalizedValue  String
  confidence       Float
  sourceDocumentId String
  sourceDocument   EvidenceDocument @relation(fields: [sourceDocumentId], references: [id])
  sourceSpan       String
  isContradiction  Boolean
  createdAt        DateTime         @default(now())
}

model DisputeDraft {
  id                   String      @id
  disputeCaseId        String
  disputeCase          DisputeCase @relation(fields: [disputeCaseId], references: [id])
  draftText            String
  claimIdsJson         String
  validationStatus     String // PASSED, FAILED, NEEDS_REVIEW
  validationErrorsJson String?
  createdBy            String
  createdAt            DateTime    @default(now())
}

model ReconciliationCase {
  id                  String         @id
  paymentIntentId     String?
  paymentIntent       PaymentIntent? @relation(fields: [paymentIntentId], references: [id])
  providerReference   String?
  outcome             String // MATCHED, MISSING_INTERNAL, MISSING_EXTERNAL, AMOUNT_MISMATCH, STATUS_MISMATCH, DUPLICATE
  severity            String // INFO, WARNING, CRITICAL
  status              String // OPEN, INVESTIGATING, RESOLVED, FROZEN
  internalAmountPaise Int?
  externalAmountPaise Int?
  notes               String?
  correlationId       String
  createdAt           DateTime       @default(now())
  resolvedAt          DateTime?
}

model DemoScenario {
  id          String   @id
  name        String
  description String
  status      String
  createdAt   DateTime @default(now())
}

model MockProviderRecord {
  id                     String   @id
  providerPaymentId      String   @unique
  providerIdempotencyKey String   @unique
  providerOrderId        String?
  amountPaise            Int
  status                 String
  failureMode            String?
  webhookSent            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model IdempotencyKey {
  id            String    @id @default(cuid())
  key           String    @unique
  operationType String // "APPROVE_OPPORTUNITY", "APPROVE_PAYMENT", "RESOLVE_RECONCILIATION", etc.
  requestHash   String // SHA256 hash of request body
  operationId   String // Reference to the financial operation
  status        String // "PENDING", "SUCCESS", "FAILED"
  responseHash  String? // SHA256 hash of response for replay
  error         String? // Error message if status is FAILED
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([key])
  @@index([operationType])
  @@index([status])
}

model Invoice {
  id                     String            @id
  tenantId               String
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceHash             String            @unique
  idempotencyKey         String            @unique
  fileName               String
  mimeType               String
  fileSizeBytes          Int
  vendorName             String
  vendorGstin            String
  invoiceNumber          String
  invoiceDate            DateTime
  dueDate                DateTime?
  subtotalPaise          Int
  taxPaise               Int
  totalPaise             Int
  extractionStatus       String            @default("PENDING")
  validationStatus       String            @default("PENDING")
  anomalyStatus          String            @default("OPEN")
  anomalyRisk            String            @default("MEDIUM")
  anomalyScore           Int               @default(50)
  anomalyReasonCodesJson String            @default("[]")
  explanation            String?
  explanationStatus      String            @default("PENDING")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  controllerTraces       ControllerTrace[]

  @@index([tenantId, createdAt])
  @@index([tenantId, anomalyStatus])
}

model ControllerTrace {
  id             String   @id
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  runStatus      String
  recommendation String
  stopReason     String?
  modelVersion   String?
  correlationId  String
  toolCallsJson  String   @default("[]")
  factsJson      String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([invoiceId, createdAt])
}

/// Runtime risk controls. A single row (id = "default") that operators can
/// change without a deploy, because the moment you need a kill switch is
/// never the moment you can wait for a release.
model RiskControl {
  id                          String    @id @default("default")
  /// When true, no payment may be submitted to the provider for any reason.
  killSwitchEngaged           Boolean   @default(false)
  killSwitchReason            String?
  killSwitchEngagedBy         String?
  killSwitchEngagedAt         DateTime?
  /// Total value that may be advanced across all suppliers in one day.
  dailyExposureLimitPaise     Int       @default(100000000)
  /// Largest single advance.
  perTransactionCapPaise      Int       @default(15000000)
  /// Advances at or above this size require a second approver.
  dualApprovalThresholdPaise  Int       @default(7500000)
  /// Most that may be outstanding to any one supplier at once.
  perSupplierLimitPaise       Int       @default(30000000)
  invoiceAutoProcessingHalted Boolean   @default(false)
  invoiceHaltReason           String?
  updatedAt                   DateTime  @updatedAt
  updatedBy                   String?
}

/// A single execution of the Track 04 finance-operations benchmark.
///
/// Persisted because a score with no history is a claim, not a measurement.
/// Storing the dataset and controller versions alongside the metrics is what
/// makes a regression legible: if the match rate falls, the row tells you
/// whether the data changed, the controller changed, or neither.
model BenchmarkRun {
  id       String   @id
  runAt    DateTime @default(now())
  /// Who pressed the button. "cli" for a terminal run.
  operator String

  /// Provenance - enough to reproduce this exact number.
  datasetVersion    String
  datasetSeed       Int
  controllerVersion String
  split             String

  /// Volume and speed.
  recordsProcessed Int
  elapsedMs        Float
  recordsPerSecond Float

  /// Operational accuracy.
  correctlyResolved       Int
  matchRate               Float
  autoResolutionRate      Float
  exceptionRate           Float
  /// Of the records the controller cleared, the share it was right to clear.
  autoResolutionPrecision Float

  /// Error decomposition.
  falseResolutions    Int
  missedMatches       Int
  wrongExceptionTypes Int

  /// Financial materiality, in paise.
  ///
  /// BigInt, not Int. These are aggregates over hundreds of records, and the
  /// first recorded run overflowed a 32-bit column at Rs 4.8 crore
  /// (4,805,212,772 paise). Per-payment columns elsewhere stay Int because a
  /// single advance cannot approach that; a total plainly can.
  valueReconciledPaise    BigInt
  valueHeldForReviewPaise BigInt
  valueExposedPaise       BigInt
  valueAtRiskPaise        BigInt

  /// Financial safety.
  duplicatePaymentsPrevented Int
  exceptionCount             Int
  /// Whether the live ledger footed at the moment of the run.
  ledgerBalanced             Boolean
  /// BigInt for the same reason as the totals above: an imbalance large enough
  /// to overflow an Int is exactly the one you need recorded, not dropped.
  ledgerImbalancePaise       BigInt

  reviews ExceptionReview[]

  @@index([runAt])
}

/// One escalated record, and what a human decided about it.
///
/// The controller abstains; this is where the abstention gets resolved. Rows
/// start OPEN and only a person moves them, which is the entire point - an
/// exception that the system could close by itself would not have been an
/// exception.
model ExceptionReview {
  id    String       @id
  runId String
  run   BenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  recordId           String
  exceptionType      String
  amountPaise        Int
  supplierName       String
  confidence         Float
  reason             String
  recommendedAction  String
  whyNotAutoResolved String
  difficulty         String

  /// OPEN | ACCEPTED | REJECTED | RELINKED | MARKED_DUPLICATE | FROZEN
  status           String    @default("OPEN")
  /// The external record an operator linked instead, when they relinked.
  linkedExternalId String?
  reviewerId       String?
  reviewNote       String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([runId, recordId])
  @@index([runId, status])
  @@index([status])
}
