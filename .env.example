DATABASE_URL="file:./dev.db"
APP_MODE="demo"
RAZORPAY_MODE="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
DEMO_OPERATOR_ID="demo-finance-operator"
NEXT_PUBLIC_APP_NAME="Equilibrium"

# --- Live Razorpay (optional) -------------------------------------------
# The app runs fully against MockRazorpay without these. Set them to exercise
# the real API and prove the integration with: npm run razorpay:check
#
# Get test keys: dashboard.razorpay.com > Test Mode > Settings > API Keys
# RAZORPAY_MODE=live            # 'mock' (default) or 'live'
# RAZORPAY_API_MODE=orders      # 'orders' (any test key) or 'payouts' (RazorpayX)
# RAZORPAY_ACCOUNT_NUMBER=      # RazorpayX virtual account, payouts mode only
